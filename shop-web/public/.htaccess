# Bagz shop (Vite SPA) — upload with the rest of shop-web/dist to Hostinger public_html
# The shop's home page (even if an old WordPress index.php is still in this folder)
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # One address for Google: www → bagzappleservices.com, and always https
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  # Old WordPress sitemaps → the new one
  RewriteRule ^(sitemap_index\.xml|sitemap\.xsl|wp-sitemap[^/]*\.xml|[a-z0-9_-]+-sitemap[0-9]*\.xml)$ /sitemap.xml [R=301,L,NC]
  # Old WordPress information pages → the matching help pages
  RewriteRule ^(about|about-us)/?$ /help/about [R=301,L,NC]
  RewriteRule ^(contact|contact-us|contacts)/?$ /help/support [R=301,L,NC]
  RewriteRule ^(privacy|privacy-policy)/?$ /help/privacy [R=301,L,NC]
  RewriteRule ^(terms|terms-and-conditions|terms-conditions)/?$ /help/terms [R=301,L,NC]
  RewriteRule ^(refund|returns?|refund[a-z_-]*|return[a-z_-]*|warranty)/?$ /help/protection [R=301,L,NC]
  RewriteRule ^(shipping|delivery|shipping[a-z_-]*|delivery[a-z_-]*)/?$ /help/shipping [R=301,L,NC]
  # LEGACY-REDIRECTS (old WordPress links → new pages; filled in by scripts/prerender-seo.mjs)
  # Prerendered SEO pages: /p/<slug>, /c/<slug> and /help/<id> are served from p/<slug>.html, c/<slug>.html and help/<id>.html
  RewriteCond %{REQUEST_URI} ^/(p|c|help)/[^/]+/?$
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
  # The shop's own pages (product, category, help) start the app
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(p|c|help)(/.*)?$ index.html [L]
</IfModule>

# Any other address does not exist: Google gets a real "404 not found",
# while a person still sees the shop (it opens on the home page).
ErrorDocument 404 /index.html

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# Service worker: always revalidate
<Files "pesapal-config.php">
  Require all denied
</Files>
<Files "firestore-config.php">
  Require all denied
</Files>
# Upload bookkeeping from the GitHub deploy
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

<Files "sw.js">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </IfModule>
</Files>
