# Copy to .env (or set these before npm run build). Vite embeds them at build time.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=fancydeals-ug.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fancydeals-ug
VITE_FIREBASE_STORAGE_BUCKET=fancydeals-ug.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_PUBLIC_SITE_URL=https://fancydeals.ug
