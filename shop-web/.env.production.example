# Copy to .env (or set these before npm run build). Vite embeds them at build time.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_PUBLIC_SITE_URL=https://bagzappleservices.com
# VITE_PAYMENT_API_URL=https://api.bagzappleservices.com

# Order emails (free): get a key at https://web3forms.com for info@bagzappleservices.com
VITE_WEB3FORMS_KEY=
# Show 'Pay now' (Pesapal) at checkout once the website and its PHP payment files are hosted
VITE_ONLINE_PAYMENTS=false

