VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# When your MoMo API is ready:
# VITE_PAYMENT_API_URL=https://your-api.example.com

# Public shop URL (canonical links, Open Graph, sitemap — use your real domain)
VITE_PUBLIC_SITE_URL=https://bagzappleservices.com

# Google Play listing (default: com.bagzappleservices.app)
# VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.bagzappleservices.app

# Order emails (free): get a key at https://web3forms.com for info@bagzappleservices.com
VITE_WEB3FORMS_KEY=
# Show 'Pay now' (Pesapal) at checkout once the website and its PHP payment files are hosted
VITE_ONLINE_PAYMENTS=false


# Customer + shop order emails with product photos (https://www.emailjs.com, free 200/month)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

