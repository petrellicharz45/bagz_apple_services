{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && cd .. && npx firebase emulators:start --only functions",
    "serve:invites": "npm run build && cd .. && npx firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "vitest run src"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.2",
    "@nile-squad/nylonpay-ts": "^1.3.0",
    "axios": "^1.7.2",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.0",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  },
  "private": true
}
