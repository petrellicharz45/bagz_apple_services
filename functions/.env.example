# Staff invite emails (Cloud Functions — set in Firebase Functions config or .env for local emulator)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Public URL of the admin app (invite links), e.g. http://localhost:5174 or https://fancydeals-ug.web.app
ADMIN_APP_URL=http://localhost:5174
# Comma-separated emails allowed to call admin APIs when admin claim is not set yet (dev/staging only)
DEV_ADMIN_EMAILS=ssempijjadickson@gmail.com,directorac162@gmail.com

# Pesapal Configuration
# To use your own sandbox/live keys, copy this file to .env and fill in your details
PESAPAL_ENVIRONMENT="sandbox" # Change to "production" when going live
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""

# Note: The default keys in pesapal.ts are public sandbox keys provided by Pesapal's official documentation
# See: https://developer.pesapal.com/how-to-integrate/e-commerce/api-30-json/api-reference
