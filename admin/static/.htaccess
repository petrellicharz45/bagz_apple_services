# Bagz admin (SvelteKit static SPA): included in admin/build by npm run build.
# Served from https://bagzappleservices.com/admin/ (the "admin" folder inside the shop's public_html).
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /admin/
  # Always https, and one address (no www)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  # Pass the admin's sign-in token through to analyze-product.php (Apache drops it otherwise)
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  # Any admin page (/admin/orders, /admin/products/123 …) starts the admin app
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

ErrorDocument 404 /admin/index.html

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  # The admin console should never appear in search results or inside other sites
  Header set X-Robots-Tag "noindex, nofollow"
  Header set X-Frame-Options "SAMEORIGIN"
  # Always load the newest admin after a deploy (file names in assets/ change on every build)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Secrets for the AI endpoint: never served directly
<Files "analyze-config.php">
  Require all denied
</Files>
<Files "analyze-config.sample.php">
  Require all denied
</Files>
# Upload bookkeeping from the GitHub deploy
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
