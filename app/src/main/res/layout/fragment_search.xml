<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.fragments.shopping.SearchFragment">

    <!-- Premium Luxury Search Header -->
    <LinearLayout
        android:id="@+id/searchHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal"
        android:paddingHorizontal="15dp"
        android:paddingVertical="10dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/searchBarLayout"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/search_box_border_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="3dp">

            <EditText
                android:id="@+id/edSearchBox"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/poppins_light"
                android:hint="Winter Gown For Women"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/semi_black"
                android:textColorHint="#919394"
                android:textSize="13sp"
                tools:ignore="Autofill" />

            <ImageView
                android:id="@+id/ivScan"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginHorizontal="8dp"
                android:contentDescription="@string/scan"
                android:src="@drawable/ic_scan"
                app:tint="#666666" />

            <!-- Sleek Solid Black Search Button -->
            <FrameLayout
                android:id="@+id/btnSearch"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:background="@drawable/black_search_button_background"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/ivSearchNow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/search_now"
                    android:src="@drawable/ic_search"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/white" />
            </FrameLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Category Segments (All, Women, Curve, Kids, Men, Home) -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchHeader"
        app:tabIndicatorColor="@color/black"
        app:tabIndicatorHeight="3dp"
        app:tabMode="scrollable"
        app:tabRippleColor="#0D000000"
        app:tabSelectedTextColor="@color/black"
        app:tabTextColor="#7E8081"
        app:tabSelectedTextAppearance="@style/tabLayout_text"
        app:tabTextAppearance="@style/tabLayout_text" />

    <!-- Split Category Browsing Layout -->
    <LinearLayout
        android:id="@+id/layoutCategoryBrowsing"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayoutCategory">

        <!-- Left Sidebar Categories -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSidebarCategories"
            android:layout_width="104dp"
            android:layout_height="match_parent"
            android:background="#FAF9F6"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="56dp" />

        <!-- Vertical Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E9EAEC" />

        <!-- Right pane: subcategories or products; sidebar stays visible -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvSubcategoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/sf_pro_display"
                android:text="Picks for You"
                android:textColor="#1B1512"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollSubcategories"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSubcategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="8dp"
                    android:paddingBottom="56dp" />
            </androidx.core.widget.NestedScrollView>

            <LinearLayout
                android:id="@+id/layoutProducts"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvProducts"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingHorizontal="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="8dp" />

                    <include
                        android:id="@+id/shimmerProducts"
                        layout="@layout/shimmer_product_multi" />

                    <TextView
                        android:id="@+id/tv_empty_search"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/poppins_light"
                        android:gravity="center"
                        android:padding="16dp"
                        android:text="@string/no_search_results_found"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </FrameLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSeeMoreProducts"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/blue_background"
                    android:text="See more"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Progress indicator -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressbarProducts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="15dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="#CED5DC"
        app:indicatorDirectionCircular="clockwise"
        app:indicatorInset="4dp"
        app:indicatorSize="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:trackColor="@color/transparent"
        app:trackCornerRadius="5dp"
        app:trackThickness="3dp" />

</androidx.constraintlayout.widget.ConstraintLayout>