<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shopTopBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:elevation="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/ivShopLogo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_fancy_deals_small" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@drawable/search_box_border_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <EditText
            android:id="@+id/edGlobalSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search products, brands and categories"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/semi_black"
            android:textColorHint="#919394"
            android:textSize="13sp"
            tools:ignore="Autofill" />

        <ImageView
            android:id="@+id/ivGlobalSearch"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/black_search_button_background"
            android:padding="7dp"
            android:src="@drawable/ic_search"
            app:tint="@color/white"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivHeaderHelp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:padding="8dp"
        android:src="@drawable/ic_info"
        app:tint="#EA580C"
        tools:ignore="ContentDescription" />

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="2dp">

        <ImageView
            android:id="@+id/ivHeaderCart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:src="@drawable/ic_cart"
            app:tint="#EA580C"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tvHeaderCartCount"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_size_chip_selected"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:visibility="gone"
            tools:text="2" />
    </FrameLayout>
</LinearLayout>
