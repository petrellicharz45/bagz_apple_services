<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1B1512"
    android:paddingHorizontal="15dp"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/iv_mail"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_mail_outline"
        app:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/iv_calendar"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="12dp"
        android:src="@drawable/ic_calendar_outline"
        app:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_mail"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <!-- Search Bar -->
    <LinearLayout
        android:id="@+id/searchBarContainer"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_marginHorizontal="12dp"
        android:background="@drawable/premium_search_box_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/iv_heart"
        app:layout_constraintStart_toEndOf="@id/iv_calendar"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_light"
            android:text="Search Gowns, Sleepwear, Shoes..."
            android:textColor="#888888"
            android:textSize="12sp"
            android:singleLine="true" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginHorizontal="8dp"
            android:src="@drawable/ic_scan"
            app:tint="#888888"
            tools:ignore="ContentDescription" />

        <!-- Sleek Search Button Container -->
        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="34dp"
            android:background="@drawable/premium_search_button_background"
            android:padding="6dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_search"
                app:tint="@color/white"
                tools:ignore="ContentDescription" />
        </FrameLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_heart"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_heart_outline"
        app:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

</androidx.constraintlayout.widget.ConstraintLayout>
