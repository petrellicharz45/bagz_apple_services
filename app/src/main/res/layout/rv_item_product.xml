<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/transparent"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardCornerRadius="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp">

        <!-- Premium Vertical 3:4 Fashion Image -->
        <ImageView
            android:id="@+id/imgProduct"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="3:4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />

        <!-- Info row (Tag + Product Name) -->
        <LinearLayout
            android:id="@+id/linear_product_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginHorizontal="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgProduct">

            <!-- Red discount badge -->
            <TextView
                android:id="@+id/tvProductDiscount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/discount_badge_background"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1.5dp"
                android:textColor="#FF5A5A"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="-20%"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_display"
                android:maxLines="1"
                android:textColor="#1B1512"
                android:textSize="12sp"
                tools:text="SHEIN EZwear Lettuce Edge Wa..." />

        </LinearLayout>

        <!-- Bold Red Fashion Price -->
        <TextView
            android:id="@+id/tvProductNewPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="2dp"
            android:fontFamily="@font/sf_pro_display"
            android:textColor="#FF5A5A"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/linear_product_info"
            tools:text="UGX 45,000" />

        <TextView
            android:id="@+id/tvProductOldPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:alpha="0.5"
            android:fontFamily="@font/sf_pro_display"
            android:textColor="@color/g_gray700"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="@id/tvProductNewPrice"
            app:layout_constraintStart_toEndOf="@id/tvProductNewPrice"
            app:layout_constraintTop_toTopOf="@id/tvProductNewPrice"
            tools:text="UGX 55,000" />

        <!-- Star rating row -->
        <LinearLayout
            android:id="@+id/linearRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginStart="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvProductNewPrice">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/ic_star_rating"
                app:tint="@color/g_orange_yellow"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvProductRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/poppins_light"
                android:textColor="#888888"
                android:textSize="10sp"
                tools:text="4.5 (1000+)" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>