<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bagz_navy">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp">

        <ImageView
            android:id="@+id/ivSplashLogo"
            android:layout_width="240dp"
            android:layout_height="57dp"
            android:alpha="0"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/bagz_logo_white" />

        <View
            android:id="@+id/splashRule"
            android:layout_width="42dp"
            android:layout_height="2dp"
            android:layout_marginTop="22dp"
            android:alpha="0"
            android:background="#FFFFFF" />

        <TextView
            android:id="@+id/tvSplashSlogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0"
            android:fontFamily="@font/sf_pro_display"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:text="Authentic Genuine Gadget Store"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSplashVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:alpha="0"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp" />

</FrameLayout>
