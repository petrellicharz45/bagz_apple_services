<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.fragments.settings.TermsFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarTerms"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imageTermsClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/icon_background_round"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/semi_black"
                tools:ignore="ContentDescription" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:text="Terms &amp; Delivery Policy"
                android:textColor="@color/semi_black"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_light"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/imageTermsClose"
                app:layout_constraintStart_toEndOf="@id/imageTermsClose"
                app:layout_constraintTop_toTopOf="@+id/imageTermsClose" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarTerms">

        <TextView
            android:id="@+id/tvTermsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:textColor="@color/semi_black"
            android:fontFamily="@font/poppins_light"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
